*.o
*.d
*.map
*.cyclo
*.su
*.png
*.chm
*.jpg
*.log
*.zip
dist/

# NemaGFX のコンパイル済みバイナリ（Think Silicon製、STのライセンス条件により
# 「Ported Software Packageに組み込んだバイナリ形式でのみ配布可」。ヘッダ・
# テンプレートは個別のファイル単位の許諾があるため同梱する）。
# tools/setup_nema_lib.ps1・.sh でST公式リポジトリから直接取得する。
landmarks/Lib/NemaGFX/lib/**/*.a
landmarks/Lib/NemaGFX/lib/**/*.lib

# usbx（Azure RTOS USBX）はビルドに一切使用されていないため除外
landmarks/STM32Cube_FW_N6/Middlewares/ST/usbx/

# STM32CubeIDE (CDT) auto-generated build files — regenerated by Clean -> Build.
# Hand-authored tenomi_*.mk fragments inside Debug/Release are NOT matched by these.
mtk3bsp2_stm32n657/Appli/Debug/**/subdir.mk
mtk3bsp2_stm32n657/Appli/Debug/makefile
mtk3bsp2_stm32n657/Appli/Debug/objects.mk
mtk3bsp2_stm32n657/Appli/Debug/sources.mk
mtk3bsp2_stm32n657/Appli/Debug/objects.list
mtk3bsp2_stm32n657/Appli/Debug/build_*.txt
mtk3bsp2_stm32n657/Appli/Debug/m5_build_log.txt
mtk3bsp2_stm32n657/Appli/Debug/build_out.txt
mtk3bsp2_stm32n657/Appli/Debug/*.elf
mtk3bsp2_stm32n657/Appli/Debug/*.bin
mtk3bsp2_stm32n657/Appli/Debug/*.list

mtk3bsp2_stm32n657/Appli/Release/**/subdir.mk
mtk3bsp2_stm32n657/Appli/Release/makefile
mtk3bsp2_stm32n657/Appli/Release/objects.mk
mtk3bsp2_stm32n657/Appli/Release/sources.mk
mtk3bsp2_stm32n657/Appli/Release/objects.list
mtk3bsp2_stm32n657/Appli/Release/*.elf
mtk3bsp2_stm32n657/Appli/Release/*.bin
mtk3bsp2_stm32n657/Appli/Release/*.list

# hand_landmark のコア別ビルド出力（c3/c5）
mtk3bsp2_stm32n657/Appli/Release/Application/hand_landmark/c3/
mtk3bsp2_stm32n657/Appli/Release/Application/hand_landmark/c5/

# FSBL/Debug は丸ごと生成物なのでフォルダ単位で除外
mtk3bsp2_stm32n657/FSBL/Debug/

mtk3bsp2_stm32n657/FSBL/Release/**/subdir.mk
mtk3bsp2_stm32n657/FSBL/Release/makefile
mtk3bsp2_stm32n657/FSBL/Release/objects.mk
mtk3bsp2_stm32n657/FSBL/Release/sources.mk
mtk3bsp2_stm32n657/FSBL/Release/objects.list
mtk3bsp2_stm32n657/FSBL/Release/*.elf
mtk3bsp2_stm32n657/FSBL/Release/*.bin
mtk3bsp2_stm32n657/FSBL/Release/*.list
